# Copie este arquivo para ".env" e preencha com seus valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# Connection string do PostgreSQL.
# Exemplo local (Postgres instalado na sua máquina):
# DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/sistema_rotas"
# Exemplo na nuvem (Neon/Railway): cole a connection string que o serviço te deu.
DATABASE_URL=""

# Chave da API do Google Maps (Directions/Geocoding).
GOOGLE_MAPS_API_KEY=""

# Porta em que o servidor local vai rodar.
PORT=3000
